meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "password123",
    "displayName": "Bruno"
  }
}

script:pre-request {
  bru.setVar("email", "bruno" + Date.now() + "@test.com");
}

script:post-response {
  bru.setVar("accessToken", res.body.accessToken);
  bru.setVar("refreshToken", res.body.refreshToken);
}

tests {
  test("пользователь создан", function () {
    expect(res.status).to.equal(201);
  });
}
