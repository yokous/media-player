meta {
  name: Login: неверный пароль
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrongpass1"
  }
}

tests {
  test("INVALID_CREDENTIALS", function () {
    expect(res.status).to.equal(401);
    expect(res.body.error.code).to.equal("INVALID_CREDENTIALS");
  });
}
