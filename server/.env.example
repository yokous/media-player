# Скопируйте в .env и поменяйте значения. Файл .env в git НЕ коммитим.
DB_PASSWORD=change-me
# не короче 32 символов, например: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
SEED_DEMO_DATA=true

# Дома оставьте как есть. На VPS: API_BIND=127.0.0.1 и API_PORT=8081
API_BIND=0.0.0.0
API_PORT=8080

# Внешние сервисы. Можно оставить пустыми: сервер работает, но
# без объяснений ИИ (AI_API_KEY) и без распознавания музыки (RECOGNITION_API_KEY).
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
RECOGNITION_API_KEY=

# Ограничение частоты запросов (на один IP в минуту)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_MINUTE=10
